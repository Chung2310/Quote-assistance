# Application server (API + frontend)
PORT=3013
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/phone_retail
MONGODB_USER=
MONGODB_PASSWORD=
MONGODB_AUTH_SOURCE=admin

# Session
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_COOKIE_SECURE=false

# AI (optional)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
OPENROUTER_APP_NAME=AI Bao Gia Pilot

# Shared Cloudinary storage (optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Shared pricing defaults
DEFAULT_TAX_RATE=0
CURRENCY=VND

# Initial admin account (leave empty when one already exists in MongoDB)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Quản trị hệ thống
SEED_ADMIN_COMPANY_NAME=
